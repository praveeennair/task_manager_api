# Environment Selection: development | qa | production
DJANGO_ENV=development

# App Configuration
DEBUG=False
SECRET_KEY=generate-a-strong-secret-key-for-production
# Optional regex host overrides (defaults are defined in QA.py and production.py)
# QA_HOST_REGEX=^([a-zA-Z0-9-]+\.)*qa\.yourdomain\.com$
# PROD_HOST_REGEX=^([a-zA-Z0-9-]+\.)*yourdomain\.com$
CSRF_TRUSTED_ORIGINS=https://*.yourdomain.com,https://yourdomain.com
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
POSTGRES_DB=task_manager_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
